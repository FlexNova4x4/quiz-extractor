# ==============================================================================
# Quiz Extractor Configuration
# ==============================================================================
# Place this file at ~/.quizbot.env or .env in the project directory.
#
# IMPORTANT ARCHITECTURE NOTE:
# This project uses BOTH Telethon (User Session) and Telegram Bot API:
# 1. Telethon User Session: Interacts with @QuizBot and @advance_quiz_bot as a user
#    (deep-linking, clicking buttons, voting on polls, reading poll answers).
# 2. Telegram Bot API: Serves as the user-facing bot where you send quiz links/cards
#    and receive the extracted TXT quiz files.
# ==============================================================================

# --- Telethon User Credentials (from https://my.telegram.org) ---
# Required for interacting with QuizBot and Advance Quiz Bot
TG_API_ID=YOUR_TELEGRAM_API_ID
TG_API_HASH=YOUR_TELEGRAM_API_HASH_HERE

# Path to the Telethon session file (without .session extension)
# The system automatically detects existing session files in the project directory
# or Termux home (~/quiz-extractor/telegram_session).
# You can explicitly set it if needed:
# Example for Termux: TG_SESSION_PATH=/data/data/com.termux/files/home/quiz-extractor/telegram_session
# Example for Linux: TG_SESSION_PATH=~/quiz-extractor/telegram_session
# Or relative to project: TG_SESSION_PATH=./telegram_session
TG_SESSION_PATH=

# --- Telegram Bot API Token (from @BotFather) ---
# Required for the user-facing Telegram Bot interface
TG_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# --- Access Control (Security) ---
# Optional: Comma-separated list of Telegram User IDs authorized to use the bot.
# Example: AUTHORIZED_USERS=123456789,987654321
# Leave empty to allow any user who messages the bot.
AUTHORIZED_USERS=

# --- Export Directory ---
# Where generated quiz TXT files will be stored.
# Default in Termux: ~/storage/shared/QuizExports
EXPORT_DIR=
